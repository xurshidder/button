# Button — required environment variables.
#
# KEY NAMES ONLY. Never put real values in this file — it is committed.
# Real values go in .env.local (gitignored) and in the host's env var UI.
# See CLAUDE.md §22.

# ── Database (CLAUDE.md §21.2) ───────────────────────────────────────────────
# DATABASE_URL must be the POOLED connection string. Serverless functions each
# open their own connection and will exhaust Postgres under an Instagram spike.
DATABASE_URL=
# Direct (unpooled) connection — used by `prisma migrate` only, never at runtime.
DIRECT_URL=

# ── Object storage for product images ────────────────────────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ── Admin auth (CLAUDE.md §11) ───────────────────────────────────────────────
# Password for the /admin panel (interim shared password).
ADMIN_PASSWORD=

AUTH_SECRET=

# ── Observability (CLAUDE.md §21.4) ──────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Alerting: alerts go to Telegram, not email — that is where the team is ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── Public site config ───────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
